{
  "name": "dsh-webdev-viewer",
  "description": "Right-sidebar Web/Electron development viewer for DeepSeek Harness: a native Desktop webview plus a CDP fallback, shared agent tools, element picking, static preview, live reload, project runner, and Electron attach.",
  "version": "0.2.0",
  "private": false,
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.shared.json && tsdown",
    "watch": "tsc -p tsconfig.shared.json && tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "ansis": "^4.5.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "icon.svg",
    "locale",
    "docs",
    "LICENSE",
    "NOTICE",
    "UPSTREAM.md",
    "LICENSES",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "license": "Apache-2.0"
}
